<?xml version = "1.0" encoding = "utf-8" ?>
<gadget>
    <name>MyDictionary</name>
    <namespace>MyDictionary.gadget</namespace>
    <version>1.3.0.0</version>

    <author name = "Christopher C. Kennedy">
        <info url = "www.southside-solutions.com"/>
        <icon src = "MyDictionary Icon.png"/>
