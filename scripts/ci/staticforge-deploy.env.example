# Host-only secrets for scripts/host-deploy.sh (never commit).
# Copy to ~/.secrets/staticforge-deploy.env and fill in.

# Application key (sfapp_...) or leave blank and set DEPLOY_DEV_LOGIN_KEY
# STATICFORGE_APP_KEY=sfapp_...

# Dev login key from secure.config.json (loopback /agent/broadcast)
# DEPLOY_DEV_LOGIN_KEY=

# Optional overrides
# STATICFORGE_HTTP_PORT=9220
# STATICFORGE_LIVE_ROOT=/home/kanmi/staticforge
