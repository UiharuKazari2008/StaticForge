# Copy to repo root as dreamscape-sync.env (gitignored), or to
# ~/.config/dreamscape/sync.env
#
# Other side of the sync (SSH + absolute path to the Dreamscape tree).
# Examples:
#   DREAMSCAPE_REMOTE=kanmi@dreamscape.example:/home/kanmi/staticforge
#   DREAMSCAPE_REMOTE=user@192.168.1.10:/opt/dreamscape

DREAMSCAPE_REMOTE=user@host:/path/to/staticforge

# Optional: extra ssh options (quoted as one string if needed)
# DREAMSCAPE_SSH_OPTS=-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes
