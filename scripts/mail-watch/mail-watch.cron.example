# /etc/cron.d/mail-watch
# Placeholder service user and paths. Do not install this file as-is.
# The poller is window-agnostic; these lines are the whole schedule.
# flock -n skips a tick when the previous run still holds the lock.
#
# Frequent windows (every 5 minutes, plus a final :00 tick):
#   Mon-Fri 09:00-20:55 and 21:00
#   Sat 09:00 through Sun 01:55 and Sun 02:00
#   Sun 09:00 through Mon 01:55 and Mon 02:00
# Hourly at :00 everywhere else. Those hours are omitted below so a
# boundary :00 is not started twice.

CRON_TZ=America/New_York
SHELL=/bin/sh
PATH=/usr/bin:/bin

# Mon-Fri 09:00-20:55
*/5 9-20 * * 1-5 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Mon-Fri 21:00
0 21 * * 1-5 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Saturday 09:00-23:55
*/5 9-23 * * 6 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Saturday window continues Sunday 00:00-01:55
*/5 0-1 * * 0 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Sunday 02:00
0 2 * * 0 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Sunday 09:00-23:55
*/5 9-23 * * 0 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Sunday window continues Monday 00:00-01:55
*/5 0-1 * * 1 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Monday 02:00
0 2 * * 1 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Hourly :00 outside the windows above
# Sunday 03:00-08:00
0 3-8 * * 0 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Monday 03:00-08:00 and 22:00-23:00
0 3-8,22-23 * * 1 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Tuesday-Friday 00:00-08:00 and 22:00-23:00
0 0-8,22-23 * * 2-5 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json

# Saturday 00:00-08:00
0 0-8 * * 6 mailwatch flock -n /var/lock/mail-watch.lock /usr/bin/node /opt/staticforge/scripts/mail-watch/mail-watch.js --config /etc/mail-watch/config.json
