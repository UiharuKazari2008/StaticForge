#!/bin/sh
# Performance / power rules (StaticForge #890; .cursor/rules/phone-power-client.mdc, -server.mdc): a staged
# file may not get worse than scripts/perf-rules-baseline.json. Every pattern it counts was a real cost on
# the phones. Fix the new hit, or mark a real design need on its line with `perf: allow <reason>`.
# Enabled per checkout with: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)" || exit 0
[ -f "$root/scripts/check-perf-rules.js" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0
if ! node "$root/scripts/check-perf-rules.js" --staged; then
    echo "pre-commit: blocked by scripts/check-perf-rules.js (rules: .cursor/rules/phone-power-*.mdc)." >&2
    exit 1
fi
# Status icon registration (Yukimi, Nov 18 2026, HARD rule status-icons-registered-only): every icon has its glyph,
# popup and tap as portable code before anything is committed
if [ -f "$root/scripts/check-status-registry.js" ] && ! node "$root/scripts/check-status-registry.js" >&2; then
    echo "pre-commit: blocked by scripts/check-status-registry.js (an icon without its glyph / popup / tap)." >&2
    exit 1
fi
# Notification discipline (Yozora #1299, rule notification-discipline.mdc): every notice emit site (toast, balloon,
# message box, sound) carries a registered source id; unregistered counts per file may only go down.
if [ -f "$root/scripts/check-notifications.js" ] && ! node "$root/scripts/check-notifications.js" --staged >&2; then
    echo "pre-commit: blocked by scripts/check-notifications.js (a notice with no registered source id: .cursor/rules/notification-discipline.mdc)." >&2
    exit 1
fi
# WebSocket request names (Yozora #1350, rule notification-discipline.mdc N1/N11): every request type has words a person
# reads or an explicit ticker:false; undecided counts per file may only go down. Runs only when modules/ws/ is staged.
if [ -f "$root/scripts/check-ws-names.js" ] && ! node "$root/scripts/check-ws-names.js" --staged >&2; then
    echo "pre-commit: blocked by scripts/check-ws-names.js (a WebSocket request with no name and no ticker decision, or a stale client block: .cursor/rules/notification-discipline.mdc, #1350)." >&2
    exit 1
fi
# CaféReady tasks (#908, rule cafeready-background): the Android app runs its own bundled copy. A change here reaches
# phones only after `node scripts/sync-cafe-tasks.js --dsapp <DSApp tree>`, a DSApp commit and an app build.
if git diff --cached --name-only | grep -q '^public/scripts/tasks/'; then
    if [ -n "$DSAPP_TREE" ] && [ -d "$DSAPP_TREE" ]; then
        node "$root/scripts/sync-cafe-tasks.js" --dsapp "$DSAPP_TREE" --check >&2 || echo "pre-commit: the app's CaféReady tasks differ; sync them into DSApp (not blocking)." >&2
    else
        echo "pre-commit: CaféReady task files changed - sync them into DSApp (scripts/sync-cafe-tasks.js --dsapp <tree>) and build the app; set DSAPP_TREE to check here." >&2
    fi
fi
exit 0
