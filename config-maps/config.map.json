    {
      "path": [
        "checkpoints",
        "grandfathering",
        "day"
      ],
      "type": "object",
      "label": "Day Tier",
      "closed": true,
      "required": true
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "day",
        "max"
      ],
      "type": "number",
      "label": "Day Tier Max",
      "required": true,
      "description": "Set 0 to disable day-tier storage"
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "day",
        "rollover"
      ],
      "type": "string",
      "label": "Day Rollover Target",
      "required": false,
      "description": "Optional tier to promote into (month); null deletes excess"
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "day",
        "perBucketMax"
      ],
      "type": "number",
      "label": "Day Per-Bucket Max",
      "required": false,
      "description": "Newest snapshots kept within the same day bucket (default 1)"
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "month"
      ],
      "type": "object",
      "label": "Month Tier",
      "closed": true,
      "required": true
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "month",
        "max"
      ],
      "type": "number",
      "label": "Month Tier Max",
      "required": true,
      "description": "Set 0 to disable month-tier storage"
    },
    {
      "path": [
        "checkpoints",
        "grandfathering",
        "month",
        "rollover"
      ],
      "type": "string",
      "label": "Month Rollover Target",
      "required": false,
      "description": "null \u2014 oldest at month tier are deleted"
    },
    {
      "path": [
        "checkpoints",
        "overrides"
      ],
      "type": "object",
      "label": "Per-Resource Overrides",
      "closed": true,
      "description": "Checkpoint retention overrides keyed by resource name (e.g. metadata, tag_wiki)"
    },
    {
      "path": [
        "userPinLoginEnabled"
      ],
      "type": "boolean",
      "label": "User PIN Login Enabled"
