      "editMode": "inline",
      "required": true,
      "description": "Allow Publish to Explorer (POST explore.novelai.net/post/image). Keep false until upload flow is verified safe."
    },
    {
      "path": [
        "log_verbosity"
      ],
      "type": "string",
      "label": "Log Verbosity",
      "enum": [
        "MINIMAL",
        "NORMAL",
        "DETAILED",
        "VERBOSE"
      ],
      "description": "Console log detail level (see modules/logger.js VERBOSITY_LEVELS)"
