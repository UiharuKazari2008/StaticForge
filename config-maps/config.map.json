{
  "configId": "config",
  "label": "Application Config",
  "rules": [
    {
      "path": [],
      "type": "object",
      "label": "Application Config",
      "closed": true,
      "required": true
    },
    {
      "path": [
        "port"
      ],
      "type": "number",
      "label": "HTTP Port",
      "restartRequired": true,
      "required": true,
      "description": "TCP port the HTTP server listens on"
    },
    {
      "path": [
        "enable_dev"
      ],
      "type": "boolean",
      "label": "Developer Access",
      "editMode": "inline",
      "restartRequired": true,
      "description": "Enable routes protected by the development login key"
    },
    {
      "path": [
        "defaultGrokModel"
      ],
      "type": "string",
      "label": "Default Grok Model",
      "editorType": "input",
      "description": "Default model ID for Grok chat requests"
    },
    {
      "path": [
        "chat_streaming_enabled"
      ],
      "type": "boolean",
      "label": "Chat Streaming",
      "editMode": "inline"
    },
    {
      "path": [
        "debugNovelAI"
      ],
      "type": "boolean",
      "label": "Debug NovelAI",
      "editMode": "inline"
    },
    {
      "path": [
        "novelaiExplore"
      ],
      "type": "object",
      "label": "NovelAI Explore",
      "closed": true,
      "required": true
