        "generationQuips",
        "// Session continuity for quip generation (native xai path)"
      ],
      "type": "string",
      "label": "Comment (documentation)",
      "readOnly": true,
      "readOnlyReason": "JSON comment key \u2014 not used at runtime; remove manually if desired",
      "skip": true,
      "description": "Inline documentation copied from generationQuipsManager.js; ignored by the server"
    },
    {
      "path": [
        "generationQuips",
        "maintainQuipSession"
      ],
      "type": "boolean",
      "label": "Maintain Quip Session",
      "editMode": "inline",
