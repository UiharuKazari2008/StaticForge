    { "path": ["presets", "*", "sampler"], "type": "string" },
    { "path": ["presets", "*", "model"], "type": "string" },
    { "path": ["preset_group"], "type": "object", "label": "Preset Groups" },
    { "path": ["preset_group", "*"], "type": "object" }
  ]
