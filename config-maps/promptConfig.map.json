{
  "configId": "promptConfig",
  "label": "Prompt Config",
  "rules": [
    { "path": [], "type": "object", "label": "Prompt Config", "closed": true, "required": true },
    { "path": ["text_replacements"], "type": "object", "label": "Text Replacements", "allowAdd": true, "required": true },
    { "path": ["text_replacements", "*"], "type": "auto", "types": ["string", "array"], "itemsType": "string", "label": "Replacement", "editorType": "prompt" },
    { "path": ["text_tags"], "type": "object", "label": "Text Tags", "valueType": "object", "allowAdd": true },
    {
      "path": ["text_tags", "*"],
      "type": "object",
      "label": "Text Tag",
      "displayTemplate": "{index} - {name}",
      "displayFields": ["name", "tags"],
      "iconField": "icon",
      "defaultSkeleton": {
        "name": "",
        "tags": "",
        "icon": "fas fa-tag"
      }
    },
    { "path": ["text_tags", "*", "name"], "type": "string", "label": "Display Name", "editorType": "input", "required": true },
    { "path": ["text_tags", "*", "tags"], "type": "string", "label": "Tag Prompt", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["text_tags", "*", "icon"], "type": "string", "label": "Icon Class", "editorType": "input", "required": true },
    { "path": ["presets"], "type": "object", "valueType": "object", "label": "Presets", "allowAdd": true, "required": true },
    { "path": ["presets", "*"], "type": "object", "label": "Preset", "closed": true,
      "displayTemplate": "{index} - {name}",
      "displayFields": ["name", "preset"],
      "defaultSkeleton": {
        "prompt": "",
        "uc": "",
        "model": "v4_5",
        "resolution": "NORMAL_PORTRAIT",
        "steps": 23,
        "guidance": 5.4,
        "rescale": 0.5,
        "name": "",
        "preset": "",
        "uuid": "",
        "request_upscale": false,
        "variety": false,
        "allow_paid": false,
        "append_quality": true,
        "append_uc": 0,
        "dataset_config": { "include": [], "bias": {}, "settings": {} },
        "incrementing_indices": {}
      }
    },
    { "path": ["presets", "*", "prompt"], "type": "string", "label": "Prompt", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["presets", "*", "uc"], "type": "string", "label": "UC", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["presets", "*", "model"], "type": "string", "label": "Model", "editorType": "input", "required": true },
    { "path": ["presets", "*", "resolution"], "type": "string", "label": "Resolution", "editorType": "input", "required": true },
    { "path": ["presets", "*", "steps"], "type": "number", "label": "Steps", "required": true },
    { "path": ["presets", "*", "guidance"], "type": "number", "label": "Guidance", "required": true },
    { "path": ["presets", "*", "rescale"], "type": "number", "label": "Rescale", "required": true },
    { "path": ["presets", "*", "sampler"], "type": "string", "label": "Sampler", "editorType": "input" },
    { "path": ["presets", "*", "noiseScheduler"], "type": "string", "label": "Noise Scheduler", "editorType": "input" },
    { "path": ["presets", "*", "variety"], "type": "boolean", "label": "Variety", "editMode": "inline" },
    { "path": ["presets", "*", "request_upscale"], "type": "boolean", "label": "Request Upscale", "editMode": "inline" },
    { "path": ["presets", "*", "allow_paid"], "type": "boolean", "label": "Allow Paid", "editMode": "inline" },
    { "path": ["presets", "*", "append_quality"], "type": "boolean", "label": "Append Quality", "editMode": "inline" },
    { "path": ["presets", "*", "append_uc"], "type": "number", "label": "Append UC" },
    { "path": ["presets", "*", "workspace"], "type": "string", "label": "Workspace", "editorType": "input" },
    { "path": ["presets", "*", "target_workspace"], "type": "string", "label": "Target Workspace", "editorType": "input" },
    { "path": ["presets", "*", "name"], "type": "string", "label": "Name", "editorType": "input", "required": true },
    { "path": ["presets", "*", "preset"], "type": "string", "label": "Preset Key", "editorType": "input", "required": true },
    { "path": ["presets", "*", "uuid"], "type": "string", "label": "UUID", "editorType": "input", "required": true },
    { "path": ["presets", "*", "dataset_config"], "type": "object", "label": "Dataset Config", "closed": true, "required": true },
    { "path": ["presets", "*", "incrementing_indices"], "type": "object", "label": "Incrementing Indices", "closed": true, "required": true },
    { "path": ["quality_presets"], "type": "object", "label": "Quality Presets", "valueType": "string", "allowAdd": true },
    { "path": ["quality_presets", "*"], "type": "string", "label": "Quality String", "editMode": "modal", "editorType": "prompt" },
    { "path": ["uc_presets"], "type": "object", "label": "UC Presets", "valueType": "array", "allowAdd": true },
    { "path": ["uc_presets", "*"], "type": "array", "itemsType": "string", "label": "UC Levels" },
    { "path": ["uc_presets", "*", "*"], "type": "string", "label": "UC String", "editMode": "modal", "editorType": "prompt" },
    { "path": ["datasets"], "type": "array", "itemsType": "object", "label": "Datasets", "allowAdd": true },
    {
      "path": ["datasets", "*"],
      "type": "object",
      "label": "Dataset",
      "displayTemplate": "{index} - {name} ({type})",
      "displayFields": ["display", "name", "value"],
      "iconField": "icon",
      "defaultSkeleton": {
        "value": "",
        "display": "New Dataset",
        "icon": "fas fa-database",
        "type": "dataset",
        "min": 0,
        "max": 5,
        "default": 1,
        "negative": false,
        "sub_toggles": []
      }
    },
    { "path": ["datasets", "*", "value"], "type": "string", "label": "Prompt Value", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["datasets", "*", "display"], "type": "string", "label": "Display Name", "editorType": "input", "required": true },
    { "path": ["datasets", "*", "icon"], "type": "string", "label": "Icon", "editorType": "input", "required": true },
    { "path": ["datasets", "*", "type"], "type": "string", "label": "Type", "enum": ["dataset", "preset"], "required": true },
    { "path": ["datasets", "*", "min"], "type": "number", "label": "Min Bias", "required": true },
    { "path": ["datasets", "*", "max"], "type": "number", "label": "Max Bias", "required": true },
    { "path": ["datasets", "*", "default"], "type": "number", "label": "Default Bias", "required": true },
    { "path": ["datasets", "*", "negative"], "type": "boolean", "label": "Negative Toggle", "editMode": "inline", "required": true },
    { "path": ["datasets", "*", "sub_toggles"], "type": "array", "itemsType": "object", "label": "Sub Toggles", "required": true },
    {
      "path": ["datasets", "*", "sub_toggles", "*"],
      "type": "object",
      "label": "Sub Toggle",
      "displayTemplate": "{index} - {name}",
      "displayFields": ["name", "id"],
      "iconField": "icon",
      "defaultSkeleton": {
        "id": "",
        "name": "",
        "description": "",
        "value": "",
        "icon": "fas fa-toggle-on",
        "min": 0,
        "max": 6,
        "default": 1,
        "negative": false,
        "default_enabled": false
      }
    },
    { "path": ["datasets", "*", "sub_toggles", "*", "id"], "type": "string", "label": "Toggle ID", "editorType": "input", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "name"], "type": "string", "label": "Name", "editorType": "input", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "description"], "type": "string", "label": "Description", "editorType": "textarea", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "value"], "type": "string", "label": "Prompt Value", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "icon"], "type": "string", "label": "Icon", "editorType": "input", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "min"], "type": "number", "label": "Min Bias", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "max"], "type": "number", "label": "Max Bias", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "default"], "type": "number", "label": "Default Bias", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "negative"], "type": "boolean", "label": "Negative", "editMode": "inline", "required": true },
    { "path": ["datasets", "*", "sub_toggles", "*", "default_enabled"], "type": "boolean", "label": "Default Enabled", "editMode": "inline", "required": true },
    { "path": ["nsfw_presets"], "type": "object", "label": "NSFW Presets", "valueType": "object", "allowAdd": true },
    { "path": ["nsfw_presets", "*"], "type": "object", "label": "NSFW Level", "closed": true,
      "displayTemplate": "Level {index}",
      "displayFields": []
    },
    { "path": ["nsfw_presets", "*", "add"], "type": "object", "label": "Add Rules", "closed": true, "required": true },
    { "path": ["nsfw_presets", "*", "add", "base"], "type": "string", "label": "Base Prompt Add", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["nsfw_presets", "*", "add", "uc"], "type": "string", "label": "UC Add", "editMode": "modal", "editorType": "prompt", "required": true },
    { "path": ["nsfw_presets", "*", "remove"], "type": "auto", "types": ["array", "object"], "itemsType": "string", "label": "Remove Rules" },
    { "path": ["nsfw_presets", "*", "remove", "*"], "type": "auto", "types": ["array", "string"], "itemsType": "string", "label": "Remove Entry", "editorType": "input" },
    { "path": ["preset_group"], "type": "object", "label": "Preset Groups", "valueType": "object", "allowAdd": true, "required": true },
    { "path": ["preset_group", "*"], "type": "object", "label": "Preset Group", "closed": true,
      "displayTemplate": "{index} - {name}",
      "displayFields": ["name"],
      "defaultSkeleton": {
        "uuid": "",
        "name": "",
        "presets": []
      }
    },
    { "path": ["preset_group", "*", "uuid"], "type": "string", "label": "Group UUID", "editorType": "input", "required": true },
    { "path": ["preset_group", "*", "name"], "type": "string", "label": "Display Name", "editorType": "input", "required": true },
    { "path": ["preset_group", "*", "presets"], "type": "array", "itemsType": "string", "label": "Preset UUIDs", "required": true }
  ]
}
