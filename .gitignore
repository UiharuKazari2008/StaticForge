nax_tags.json
danbooru_tagwiki.json
danbooru_tagwiki_merged.json
e621_wiki_fixed.json
danbooru_tag_groups_hierarchy.json
tools/
# Per-agent busy locks (never commit)
.agent-*
# Ruiko upscaler local venv and generated key (never commit)
services/ruiko-upscaler/.venv/
services/ruiko-upscaler/worker.key
__pycache__/
# Local host sync remote (see scripts/dreamscape-sync.env.example)
dreamscape-sync.env
# Chrome for Testing binaries (setup-dump-deps.sh --chrome-for-testing)
.cache/chrome-for-testing/
tools/chrome-for-testing/

