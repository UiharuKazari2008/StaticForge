/images/
public/data/*
!public/data/nai-quickstart-v5.json
public/images/*
!public/images/login_array.jpg
.previews/
node_modules/
.git-audit.log
*.swp
*.bak
.env
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
config.json
*config.json
.cache/*
# Legacy SQLite snapshot dir (before unified .cache/checkpoints/<dbStem>/); safe to keep for old trees
.checkpoints/*
logs/
log.txt
securePrompts/*
tmp/
# Host-local media (Microsoft Vista WAVs) stays out of git. Cursors live in public/cursors.
/media/*
# Planet bed and the Vista WAVs the /sounds/vista route serves (desktopSoundsStatic ALLOWED_FILES)
# are committed; other WAVs copied into public/sounds/vista stay host-local.
public/sounds/*
!public/sounds/vista/
public/sounds/vista/*
!public/sounds/vista/Windows Balloon.wav
!public/sounds/vista/Windows Critical Stop.wav
!public/sounds/vista/Windows Default.wav
